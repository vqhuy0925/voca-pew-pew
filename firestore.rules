rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated (including anonymous auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is an email/password authenticated admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Helper function to check if the user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles collection for public leaderboard
    match /users/{userId} {
      // Public leaderboard can be read by all players
      allow read: if true;

      // Allow owner or Admin to create or update profile document
      allow create: if (isOwner(userId) || isAdmin())
                    && request.resource.data.totalXp is number
                    && request.resource.data.totalXp >= 0;

      allow update: if (isOwner(userId) || isAdmin())
                    && request.resource.data.totalXp is number
                    && request.resource.data.totalXp >= 0;

      // Allow Admin or owner to delete duplicate / obsolete profile documents
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Player accounts collection: Username + 4-digit PIN authentication
    match /player_accounts/{username} {
      // Allow reading player account for login verification & username availability check
      allow read: if true;

      // Allow creating a new player account with required fields
      allow create: if request.resource.data.username == username
                    && request.resource.data.pinHash is string
                    && request.resource.data.uid is string;

      // Allow updating session timestamp / profile links
      allow update: if true;

      allow delete: if false;
    }

    // Weekly leaderboard collection
    match /weekly_leaderboards/{weekId}/ranks/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // Vocab Drafts: Only password-authenticated Admin can read and write
    match /vocab_drafts/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Vocab Snapshots: Public read for players, write restricted to Admin
    match /vocab_snapshots/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Typing Dojo Paragraph Drafts: Only password-authenticated Admin can read and write
    match /typing_paragraph_drafts/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Typing Dojo Paragraph Snapshots: Public read for players, write restricted to Admin
    match /typing_paragraph_snapshots/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'password';
    }
  }
}
