rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated (including anonymous auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles collection for public leaderboard
    match /users/{userId} {
      // Public leaderboard can be read by all players
      allow read: if true;

      // Only the owner can create or update their own profile document
      allow create: if isOwner(userId)
                    && request.resource.data.totalXp is number
                    && request.resource.data.totalXp >= 0;

      allow update: if isOwner(userId)
                    && request.resource.data.totalXp is number
                    && request.resource.data.totalXp >= 0;

      allow delete: if false; // Disallow profile deletion directly
    }

    // Weekly leaderboard collection
    match /weekly_leaderboards/{weekId}/ranks/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
  }
}
